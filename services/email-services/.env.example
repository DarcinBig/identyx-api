# =============================================
# EMAIL-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=email-service
KAFKA_CONSUMER_GROUP_ID=email-service

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/1

# App
ENVIRONMENT=development
DEBUG=false

# Base URL used to build the links inside emails
# Must point to the PUBLIC gateway, with the /v1 API version
# e.g. http://localhost:8100 (dev) or https://api.yourdomain.com (prod)
APP_BASE_URL=http://localhost:8100

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAILS_FROM=noreply@yourdomain.com
EMAILS_FROM_NAME=Identyx
