# =============================================
# TOKEN-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# JWT — must match the root .env
JWT_SECRET_KEY=CHANGE_ME_SAME_AS_ROOT_ENV
JWT_ALGORITHM=HS256
JWT_ISSUER=identyx
JWT_AUDIENCE=identyx-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Inter-service shared secret (must be identical across all services)
# Required — protects /tokens/generate and /tokens/revoke
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET
