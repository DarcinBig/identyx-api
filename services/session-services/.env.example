# =============================================
# SESSION-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# PostgreSQL (own database: identyx_sessions)
POSTGRES_USER=identyx
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres-sessions
POSTGRES_PORT=5432
POSTGRES_DB=identyx_sessions

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Refresh token lifetime
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-device — max active sessions per user
MAX_SESSIONS_PER_USER=5

# Inter-service shared secret (must be identical across all services)
# Required — protects the internal session endpoints
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# App
ENVIRONMENT=development
DEBUG=false
