# =============================================
# AUTH-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# PostgreSQL (own database: identyx_auth)
POSTGRES_USER=identyx
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres-auth
POSTGRES_PORT=5432
POSTGRES_DB=identyx_auth

# JWT — must match the root .env
JWT_SECRET_KEY=CHANGE_ME_SAME_AS_ROOT_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id — OWASP parameters 2024
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Redis — brute-force protection (DB 2)
REDIS_URL=redis://:CHANGE_ME@redis:6379/2
BRUTE_FORCE_REDIS_URL=redis://:CHANGE_ME@redis:6379/2
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=auth-service

# Internal services URLs (identyx-network)
USER_SERVICE_URL=http://user-service:8001
TOKEN_SERVICE_URL=http://token-service:8003
SESSION_SERVICE_URL=http://session-service:8004
EMAIL_SERVICE_URL=http://email-service:8005

# Inter-service shared secret (must be identical across all services)
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# App
ENVIRONMENT=development
DEBUG=false
