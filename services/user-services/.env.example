# =============================================
# USER-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# PostgreSQL (own database: identyx_users)
POSTGRES_USER=identyx
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres-users
POSTGRES_PORT=5432
POSTGRES_DB=identyx_users

# GitHub (avatar storage)
GITHUB_TOKEN=CHANGE_ME
GITHUB_OWNER=CHANGE_ME
GITHUB_REPO=CHANGE_ME
GITHUB_BRANCH=main
GITHUB_AVATARS_FOLDER=avatars

# Active storage provider
STORAGE_PROVIDER=github

# Inter-service shared secret (must be identical across all services)
# Required — protects the /users/internal/* endpoints
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# App
ENVIRONMENT=development
DEBUG=false
