# =============================================
# APPLICATION-SERVICE — Environment variables (TEMPLATE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================

# PostgreSQL (own database: identyx_applications)
POSTGRES_USER=identyx
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres-applications
POSTGRES_PORT=5432
POSTGRES_DB=identyx_applications

# Redis — API-key resolution cache (dedicated DB 3)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=3

# Cache TTL for key resolutions (seconds) — active invalidation on revoke
# is the primary freshness mechanism; the TTL is only a safety net.
API_KEY_CACHE_TTL_SECONDS=60

# Inter-service shared secret (must be identical across all services)
# Required — protects every /applications/* endpoint
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# App
ENVIRONMENT=development
DEBUG=false
