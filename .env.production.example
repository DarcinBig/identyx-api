# =============================================
# IDENTYX — Production environment variables
# Copy to ../.env on the production server, then
# GENERATE fresh secrets (see commands below).
# =============================================

# Public domain of the API (must point to this host via DNS).
# Used by Caddy (HTTPS) and to build links inside emails.
DOMAIN=api.identyx.io

# App
ENVIRONMENT=production
DEBUG=false
FRONTEND=https://app.identyx.io

# Set to true when a trusted reverse proxy (Caddy, nginx, Cloudflare…)
# sits in front of the gateway.  The gateway will then read the real client
# IP from the X-Forwarded-For header set by the proxy.
TRUST_PROXY=true

# Public base URL of the API (email links are built on top of it).
# Keep in sync with DOMAIN above.
APP_BASE_URL=https://api.identyx.io

# PostgreSQL
POSTGRES_USER=identyx
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# JWT — minimum 64 random characters
# Generate: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_64_chars_min
JWT_ALGORITHM=HS256
JWT_ISSUER=identyx
JWT_AUDIENCE=identyx-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id — OWASP parameters 2024
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Redis
REDIS_URL=redis://redis:6379
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Redis Events (Pub/Sub) — deprecated, kept for compatibility
EVENTS_REDIS_DB=3

# Docker internal URLs (identyx-network)
USER_SERVICE_URL=http://user-service:8001
AUTH_SERVICE_URL=http://auth-service:8002
TOKEN_SERVICE_URL=http://token-service:8003
SESSION_SERVICE_URL=http://session-service:8004
EMAIL_SERVICE_URL=http://email-service:8005
APPLICATION_SERVICE_URL=http://application-service:8006

# Inter-service shared secret (X-Internal-Key header)
# Must be identical across auth, user, session and token services.
# Generate: openssl rand -base64 48
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# Email — production SMTP (Brevo / SendGrid / Mailgun…)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=noreply@identyx.io
EMAILS_FROM_NAME=Identyx

# GitHub — avatar storage provider (set to your infra)
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_owner
GITHUB_REPO=your_github_repo
GITHUB_BRANCH=main
GITHUB_AVATARS_FOLDER=avatars

# Active storage provider
STORAGE_PROVIDER=github

# Rate Limiting (gateway) — production values
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET_PASSWORD=3
RATE_LIMIT_VERIFY_EMAIL=5
RATE_LIMIT_REFRESH=20
RATE_LIMIT_SESSIONS=60

# Anti Brute-Force (auth-service)
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15

# Observability — Prometheus
PROMETHEUS_PORT=9090

# Observability — Grafana (auto-provisioned dashboard) — change these secrets in production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
GRAFANA_ROOT_URL=https://monitoring.identyx.io

# Observability — OpenTelemetry (distributed traces → Tempo via OTLP/HTTP)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# CORS — comma-separated allowed origins (production frontend only)
CORS_ORIGINS=https://app.identyx.io

# Native tenant (multi-tenancy)
IDENTYX_NATIVE_TENANT_ID=00000000-0000-0000-0000-000000000001
