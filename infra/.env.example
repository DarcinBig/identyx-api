# =============================================
# IDENTYX — Environment variables (TEMPLATE)
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =============================================

# PostgreSQL
POSTGRES_USER=identyx
POSTGRES_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ISSUER=identyx
JWT_AUDIENCE=identyx-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id — OWASP parameters 2024
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Redis
REDIS_PASSWORD=CHANGE_ME

# Docker internal URLs (identyx-network) — usually no change needed
USER_SERVICE_URL=http://user-service:8001
AUTH_SERVICE_URL=http://auth-service:8002
TOKEN_SERVICE_URL=http://token-service:8003
SESSION_SERVICE_URL=http://session-service:8004
EMAIL_SERVICE_URL=http://email-service:8005

# App
ENVIRONMENT=production
DEBUG=false
FRONTEND=https://frontend-domain.com

# Public base URL used to build the links inside emails (gateway + /v1)
APP_BASE_URL=https://api.yourdomain.com

# Inter-service shared secret (X-Internal-Key header)
# Must be identical across auth, user, session and token services.
# Generate with: openssl rand -base64 48
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# Email — SMTP relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAILS_FROM=noreply@yourdomain.com

# GitHub (avatar storage)
GITHUB_TOKEN=CHANGE_ME
GITHUB_OWNER=CHANGE_ME
GITHUB_REPO=CHANGE_ME
GITHUB_BRANCH=main
GITHUB_AVATARS_FOLDER=avatars

# Active storage provider
STORAGE_PROVIDER=github

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET_PASSWORD=3
RATE_LIMIT_VERIFY_EMAIL=5
RATE_LIMIT_REFRESH=20
RATE_LIMIT_SESSIONS=60

# Anti Brute-Force
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://frontend-domain.com