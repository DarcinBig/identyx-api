# =============================================
# IDENTYX — Environment Variables
# Copy this file in .env and fill the values
# =============================================

# PostgreSQL
POSTGRES_USER=identyx
POSTGRES_PASSWORD=changeme

# JWT minimum 64 random characters in production
JWT_SECRET_KEY=change_this_to_a_very_long_random_secret_key_minimum_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id — OWASP parameters 2024
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Redis
REDIS_URL=redis://redis:6379

# Docker internal URLs (identyx-network)
USER_SERVICE_URL=http://user-services:8001
AUTH_SERVICE_URL=http://auth-services:8002
TOKEN_SERVICE_URL=http://token-services:8003
SESSION_SERVICE_URL=http://session-services:8004
EMAIL_SERVICE_URL=http://email-services:8005

# App
ENVIRONMENT=development
DEBUG=true
FRONTEND=http://locahost:8000

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=noreply@identyx.io