# =============================================
# IDENTYX — Environment Variables
# Copy this file in .env and fill the values
# =============================================

# PostgreSQL
POSTGRES_USER=identyx
POSTGRES_PASSWORD=changeme

# JWT minimum 64 random characters in production
JWT_SECRET_KEY=change_this_to_a_very_long_random_secret_key_minimum_64_chars
JWT_ALGORITHM=HS256
JWT_ISSUER=identyx
JWT_AUDIENCE=identyx-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id — OWASP parameters 2024
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Docker internal URLs (identyx-network)
USER_SERVICE_URL=http://user-service:8001
AUTH_SERVICE_URL=http://auth-service:8002
TOKEN_SERVICE_URL=http://token-service:8003
SESSION_SERVICE_URL=http://session-service:8004
EMAIL_SERVICE_URL=http://email-service:8005

# App
ENVIRONMENT=development
DEBUG=true
FRONTEND=http://localhost:8000

# Public base URL used to build the links inside emails (gateway + /v1)
# e.g. http://localhost:8100 (dev) or https://api.yourdomain.com (prod)
APP_BASE_URL=http://localhost:8100

# Inter-service shared secret (X-Internal-Key header)
# Must be identical across auth, user, session and token services.
# Generate with: openssl rand -base64 48
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# Kafka / Redpanda — event bus (auth publisher + email consumer)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=identyx
KAFKA_CONSUMER_GROUP_ID=email-service-group

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=noreply@identyx.io
EMAILS_FROM_NAME=Identyx

# Rate Limiting (gateway)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET_PASSWORD=3
RATE_LIMIT_VERIFY_EMAIL=5
RATE_LIMIT_REFRESH=20
RATE_LIMIT_SESSIONS=60

# Anti Brute-Force (auth-service)
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15

# Observability — Prometheus
PROMETHEUS_PORT=9090

# Observability — Grafana (auto-provisioned dashboard)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# Observability — OpenTelemetry (distributed traces → Tempo via OTLP/HTTP)
# In the Docker network the endpoint is `http://tempo:4318`; for local runs
# outside Docker, point it to `http://localhost:4318`.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000